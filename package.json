    "test:unit": "jest --selectProjects backend tests/unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:ui": "TZ=America/Sao_Paulo jest --selectProjects ui",
    "test": "npm run test:unit && npm run test:integration",
    "test:all": "npm run test && npm run test:ui",
    "test:watch": "jest --watch",
    "test:coverage:unit": "jest --selectProjects backend tests/unit --coverage",
    "test:coverage:integration": "jest --selectProjects integration --runInBand --coverage",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:integration",
    "lint": "eslint",
    "db:seed": "npm run db:seed:dev",
    "db:seed:dev": "prisma db seed"
  },
