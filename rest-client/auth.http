### Register - sucesso
# Cria a conta e já autentica (cookie definido na resposta, igual ao sign-in).
# Se rodar de novo com o mesmo @newUserEmail, cai no caso de e-mail duplicado abaixo.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "{{newUserName}}",
  "email": "{{newUserEmail}}",
  "password": "{{newUserPassword}}"
}

###

### Register - e-mail duplicado
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "{{newUserName}}",
  "email": "{{email}}",
  "password": "{{newUserPassword}}"
}

###

### Register - senha curta (menos de 8 caracteres)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "{{newUserName}}",
  "email": "outro-novo@financecontrol.local",
  "password": "1234567"
}

###

### Register - payload inválido
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "",
  "email": "email-invalido",
  "password": ""
}

###

### Get current user - logo após o register
# Execute após "Register - sucesso" (mesmo cookie da sessão do REST Client).
# Confirma que o cookie/token emitido pelo /register autentica normalmente,
# sem precisar passar pelo /sign-in.
GET {{baseUrl}}/api/auth/me

###

### Sign in - sucesso
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###

### Sign in - usuário criado via /register
# Execute após "Register - sucesso" (usa as mesmas credenciais do novo usuário).
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "{{newUserEmail}}",
  "password": "{{newUserPassword}}"
}

###

### Sign in - usuário inexistente
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "naoexiste@financecontrol.local",
  "password": "{{password}}"
}

###

### Sign in - senha inválida
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "senha-errada"
}

###

### Sign in - payload inválido
POST {{baseUrl}}/api/auth/sign-in
Content-Type: application/json

{
  "email": "email-invalido",
  "password": ""
}

###

### Get current user - sem token
GET {{baseUrl}}/api/auth/me

###

### Get current user - autenticado
# Execute após o sign-in.
GET {{baseUrl}}/api/auth/me

###

### Get current user - autenticado com cookie manual
# Use apenas se seu REST Client não persistir cookies.
GET {{baseUrl}}/api/auth/me
Cookie: fc_access_token={{authToken}}

###

### Sign out
POST http://localhost:3000/api/auth/sign-out

###

### Update profile (name) - sucesso
# Execute após o sign-in. Se seu REST Client não persistir cookies (caso do
# GET /api/auth/me acima), atualize @authToken com o valor emitido pelo
# sign-in antes de rodar — o Cookie abaixo é enviado manualmente por isso.
PUT {{baseUrl}}/api/auth/me
Content-Type: application/json
Cookie: fc_access_token={{authToken}}

{
  "name": "Wallison Moura"
}

###

### Update profile - sem token
PUT {{baseUrl}}/api/auth/me
Content-Type: application/json

{
  "name": "Wallison Moura"
}

###

### Update profile - nome vazio
PUT {{baseUrl}}/api/auth/me
Content-Type: application/json
Cookie: fc_access_token={{authToken}}

{
  "name": ""
}

###

### Change password - sucesso
# Execute após o sign-in. A senha atual precisa bater com {{password}}.
# Atenção: isso troca a senha de verdade — depois de rodar, {{password}}
# (123456) para de bater, e "Sign in - sucesso" só volta a funcionar se você
# rodar de novo com currentPassword="nova-senha-123" e newPassword="123456"
# pra desfazer, ou atualizar @password aqui em cima.
PUT {{baseUrl}}/api/auth/me/password
Content-Type: application/json
Cookie: fc_access_token={{authToken}}

{
  "currentPassword": "{{newUserPassword}}",
  "newPassword": "nova-senha"
}

###

### Change password - senha atual incorreta
PUT {{baseUrl}}/api/auth/me/password
Content-Type: application/json
Cookie: fc_access_token={{authToken}}

{
  "currentPassword": "senha-errada",
  "newPassword": "nova-senha-123"
}

###

### Change password - nova senha curta demais
PUT {{baseUrl}}/api/auth/me/password
Content-Type: application/json
Cookie: fc_access_token={{authToken}}

{
  "currentPassword": "{{newUserPassword}}",
  "newPassword": "123"
}

###

### Change password - sem token
PUT {{baseUrl}}/api/auth/me/password
Content-Type: application/json

{
  "currentPassword": "{{password}}",
  "newPassword": "nova-senha-123"
}